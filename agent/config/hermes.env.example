# Open-Trainer agent (Hermes) — runtime environment.
# Copy to .env in the Hermes runtime (the Docker image expects these).

# --- LLM (DeepSeek) ---------------------------------------------------------
DEEPSEEK_API_KEY=
# Optional overrides (otherwise cli-config.yaml is used):
# HERMES_MODEL=deepseek-v4-flash
# HERMES_PROVIDER=deepseek

# --- Telegram ---------------------------------------------------------------
# BotFather token. One bot serves all users (shared multi-tenant).
TELEGRAM_BOT_TOKEN=
# Optional: restrict to specific Telegram user ids during testing (comma-sep).
# TELEGRAM_ALLOWED_USERS=

# --- Supabase (service role — bypasses RLS) ---------------------------------
SUPABASE_URL=https://lhquhastwnurmvyrzdeh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Product ----------------------------------------------------------------
# Shown to users who aren't subscribed yet.
OPEN_TRAINER_SUBSCRIBE_URL=https://open-trainer.app

# --- Hermes home (skills/identity overlay live here) ------------------------
HERMES_HOME=/data/hermes
